# Copy this file to .env and change values if you need to:
#   cp .env.example .env
#
# The Go API and worker read these variables on startup.

API_ADDR=:8080

# Matches the PostgreSQL service in docker-compose.yml
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse?sslmode=disable

# Matches the RabbitMQ service in docker-compose.yml
# Management UI: http://localhost:15672 (guest / guest)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

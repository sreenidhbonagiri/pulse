# Copy this file to .env and change values if you need to:
#   cp .env.example .env
#
# The Go API and worker read these variables on startup.

API_ADDR=:8080

# Matches the PostgreSQL service in docker-compose.yml
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse?sslmode=disable

# Matches the RabbitMQ service in docker-compose.yml
# Management UI: http://localhost:15672 (guest / guest)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Matches the Redis service in docker-compose.yml
# Used only for monitor statistics caching. Pulse still works if Redis is down.
REDIS_URL=redis://localhost:6379/0

# Browser origins allowed to call the API (comma-separated).
# Needed so the Vite dashboard at http://localhost:5173 can fetch from :8080.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Prometheus scrape ports. The API serves /metrics on API_ADDR.
# Worker and scheduler expose a separate metrics-only HTTP server.
WORKER_METRICS_ADDR=:8081
SCHEDULER_METRICS_ADDR=:8082
